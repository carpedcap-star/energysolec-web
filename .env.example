# Supabase (Settings → API). La service role key SOLO en servidor; nunca con prefijo NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://www.energysolec.com

# Correo transaccional (Resend). Sin clave, los correos se registran en outbound_messages como "pendiente".
RESEND_API_KEY=
EMAIL_FROM="Energy Solutions Ecuador <estudios@energysolec.com>"
SALES_NOTIFY_EMAIL=ventas@energysolec.com

# WhatsApp Business Cloud API (opcional). Sin estas variables se usa el enlace wa.me con mensaje precargado.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Protección anti-spam (Cloudflare Turnstile, opcional)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Lectura de planillas con IA (opcional). Sin clave, la calculadora no ofrece subir planilla.
# Solo servidor: nunca con prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Tope diario de lecturas en todo el sitio (cada lectura tiene costo). Por defecto 200.
BILL_DAILY_MAX=

# Solo desarrollo local sin Supabase: contraseña del panel de pruebas
DEV_ADMIN_PASSWORD=
APP_SECRET=cambiar-por-una-cadena-larga-aleatoria
IP_HASH_SALT=cambiar

# Analítica (IDs públicos)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
